{
    "name": "lbnf",
    "displayName": "Labelled BNF (LBNF)",
    "description": "An extension providing syntax highlighting and language support for LBNF.",
    "version": "1.0.0",
    "publisher": "the-wise-monkey",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/the-wise-monkey/vscode-lbnf.git"
    },
    "bugs": {
        "url": "https://github.com/the-wise-monkey/vscode-lbnf/issues"
    },
    "homepage": "https://github.com/the-wise-monkey/vscode-lbnf#readme",
    "engines": {
        "vscode": "^1.27.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "scripts": {
        "package": "npx @vscode/vsce package",
        "publish:vsce": "npx @vscode/vsce publish",
        "publish:ovsx": "npx ovsx publish"
    },
    "contributes": {
        "languages": [{
            "id": "lbnf",
            "aliases": ["LBNF", "lbnf"],
            "extensions": [".cf"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "lbnf",
            "scopeName": "source.lbnf",
            "path": "./syntaxes/lbnf.tmLanguage.json"
        }]
    },
    "icon": "docs/icon.png",
    "keywords": [
        "bnf", "bnfc", "lbnf", "syntax-highlighting"
    ]
}
